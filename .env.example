# Veil Signal Arena Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# TESTNET CONFIGURATION (Recommended for hackathon demo)
# =============================================================================

# Use Initia testnet - judges can access this
INITIA_DEFAULT_CHAIN_ID=initiation-2

# Transaction explorer for testnet
INITIA_EXPLORER_TX_BASE=https://scan.testnet.initia.xyz/initiation-2/txs

# Your deployed module address on testnet (deploy with: initia move deploy)
# Replace with your actual address after deploying
VEIL_MODULE_ADDRESS=

# Module name
VEIL_MODULE_NAME=signal_arena

# =============================================================================
# CUSTOM ROLLUP CONFIGURATION (Alternative - for local development)
# =============================================================================
# Uncomment and use these if running your own rollup (veil-signal-1)

# INITIA_DEFAULT_CHAIN_ID=veil-signal-1
# INITIA_EXPLORER_TX_BASE=https://scan.testnet.initia.xyz/veil-signal-1/txs
# VEIL_MODULE_ADDRESS=0xd0a2edc8bd949b24d391a400b869763221d23e65
# VEIL_REST_URL=http://localhost:1317
# VEIL_RPC_URL=http://localhost:26657
# VEIL_INDEXER_URL=http://localhost:3000
# VEIL_CHAIN_NAME=veil-signal-1
# VEIL_CHAIN_PRETTY_NAME=Veil Signal Arena
# VEIL_FEE_DENOM=umin
